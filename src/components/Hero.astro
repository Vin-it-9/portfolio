---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import logoImage from '@assets/img/logo.svg'

/**
 * Hero Component
 *
 * @description A component that displays a hero section with a title, description, and image
 */
interface Props {
  /**
   * The source URL for the image
   */
  src?: string
}

const { src = logoImage }: Props = Astro.props
---

<section class="hero my-4">
  <div class="container">
    <div class="grid grid-cols-1 items-center gap-24 lg:grid-cols-2">
      <div class="flex flex-col items-center gap-8 md:items-start">
        <h1 class="text-center text-6xl md:text-left lg:text-8xl">
          <slot><span class="text-gradient">Building</span> with Java</slot>
        </h1>
        <p class="text-center text-lg md:text-left">
          I enjoy building practical software with Java and the JVM ecosystem, exploring different frameworks
          and technologies to solve problems and create clean, maintainable applications. I’m continuously
          learning, improving my problem-solving skills, and turning what I learn into real-world projects.
        </p>
        <div class="flex flex-col gap-3 min-[500px]:flex-row">
          <Link
            href="/portfolio"
            isButton
            type="primary"
            animateOnHover
            animationType="boop"
            class="hero-button hero-button-primary"
          >
            <Icon aria-hidden="true" name="lucide:folder-code" size="1.5rem" />
            View My Projects
          </Link>
          <Link
            href="/resume"
            isButton
            type="secondary"
            animateOnHover
            animationType="boop"
            class="hero-button hero-button-secondary"
          >
            <Icon aria-hidden="true" name="lucide:file-text" size="1.5rem" />
            View Resume
          </Link>
        </div>
      </div>
      <Image class="hero-logo hidden lg:block" src={src} alt="Java Duke mascot" decoding="async" loading="eager" />
    </div>
  </div>
  <div class="hero-scroll-cue" aria-hidden="true">↓ Explore</div>
</section>

<style lang="scss">
  h1 {
    text-wrap: unset;
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    &::before,
    &::after {
      content: '';
      position: absolute;
      pointer-events: none;
      border-radius: 9999px;
      filter: blur(64px);
      opacity: 0.4;
      z-index: 0;
    }

    &::before {
      width: 26rem;
      height: 26rem;
      right: 8%;
      top: 10%;
      background: radial-gradient(circle, rgba(163, 87, 255, 0.36), rgba(163, 87, 255, 0));
    }

    &::after {
      width: 24rem;
      height: 24rem;
      left: 10%;
      bottom: 18%;
      background: radial-gradient(circle, rgba(39, 224, 255, 0.2), rgba(39, 224, 255, 0));
    }
  }

  .hero > .container {
    position: relative;
    z-index: 1;
  }

  .hero-logo {
    display: block;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 0 22px rgba(125, 88, 255, 0.22));
    animation: duke-float 5s ease-in-out infinite;
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .hero-logo:hover {
    transform: translateY(-2px);
    filter: drop-shadow(0 0 28px rgba(125, 88, 255, 0.28));
  }

  .hero-button {
    position: relative;
    overflow: hidden;
    border: 1px solid transparent;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, filter 0.2s ease;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
  }

  .hero-button:hover,
  .hero-button:focus-visible {
    transform: translateY(-1px);
    filter: brightness(1.04);
  }

  .hero-button:focus-visible {
    outline: 2px solid var(--outline-color);
    outline-offset: 3px;
  }

  .hero-button-primary {
    border-color: rgba(214, 72, 255, 0.35);
    box-shadow: 0 12px 28px rgba(214, 72, 255, 0.1);
  }

  .hero-button-secondary {
    border-color: rgba(59, 130, 246, 0.25);
    box-shadow: 0 10px 24px rgba(31, 41, 55, 0.1);
  }

  .hero-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 0.9rem;
    transform: translateX(-50%);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground-color) 78%, transparent);
    opacity: 0.7;
    pointer-events: none;
    z-index: 1;
    animation: cue-breathe 1s ease-in-out infinite;
  }

  .text-gradient {
    background: linear-gradient(
      315deg,
      light-dark(var(--color-primary-300), var(--color-secondary-100)) 25%,
      light-dark(var(--color-secondary-300), var(--color-primary-200))
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @keyframes duke-float {
    0%,
    100% {
      transform: translateY(5px);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @keyframes cue-breathe {
    0%,
    100% {
      opacity: 0.45;
      transform: translateX(-50%) translateY(0);
    }
    50% {
      opacity: 0.9;
      transform: translateX(-50%) translateY(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo,
    .hero-scroll-cue,
    .hero-button {
      animation: none;
      transition: none;
    }
  }
</style>