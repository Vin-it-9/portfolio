---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import logoImage from '@assets/img/logo.svg'

/**
 * Hero Component
 *
 * @description A component that displays a hero section with a title, description, and image
 */
interface Props {
  /**
   * The source URL for the image
   */
  src?: string
}

const { src = logoImage }: Props = Astro.props
---

<section class="hero my-4">
  <div class="container">
    <div class="grid grid-cols-1 items-center gap-24 lg:grid-cols-2">
      <div class="flex flex-col items-center gap-8 md:items-start">
        <h1 class="text-center text-6xl md:text-left lg:text-8xl">
          <slot><span class="text-gradient">Building</span> with Java</slot>
        </h1>
        <p class="text-center text-lg md:text-left">
          I enjoy building practical software with Java and the JVM ecosystem, exploring different frameworks
          and technologies to solve problems and create clean, maintainable applications. I’m continuously
          learning, improving my problem-solving skills, and turning what I learn into real-world projects.
        </p>
        <div class="flex flex-col gap-3 min-[500px]:flex-row">
          <Link
            href="/portfolio"
            isButton
            type="primary"
            animateOnHover
            animationType="boop"
          >
            <Icon aria-hidden="true" name="lucide:folder-code" size="1.5rem" />
            View My Projects
          </Link>
          <Link
            href="/resume"
            isButton
            type="secondary"
            animateOnHover
            animationType="boop"
          >
            <Icon aria-hidden="true" name="lucide:file-text" size="1.5rem" />
            View Resume
          </Link>
        </div>
      </div>
      <Image class="hero-logo hidden lg:block" src={src} alt="Java Duke mascot" decoding="async" loading="eager" />
    </div>
  </div>
</section>

<style lang="scss">
  h1 {
    text-wrap: unset;
  }

  .hero-logo {
    display: block;
    width: min(28rem, 100%);
    height: auto;
  }

  .text-gradient {
    background: linear-gradient(
      315deg,
      light-dark(var(--color-primary-300), var(--color-secondary-100)) 25%,
      light-dark(var(--color-secondary-300), var(--color-primary-200))
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>