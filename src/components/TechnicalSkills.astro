const bottomRow = [
  {
    name: 'Shopify',
    bg: '#95BF47',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M17 7h-3V5c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H3v13c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V7zM10 5h4v2h-4V5zm-4 5h12v9H6v-9z"/></svg>`
  },
  {
    name: 'Slack',
    bg: '#ffffff',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" stroke-width="3" stroke-linecap="round" fill="none"><path stroke="#E01E5A" d="M9 5v14"/><path stroke="#36C5F0" d="M15 5v14"/><path stroke="#2EB67D" d="M5 9h14"/><path stroke="#ECB22E" d="M5 15h14"/></svg>`
  },
  {
    name: 'Zapier',
    bg: '#FF4A00',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" stroke="white" stroke-width="3" stroke-linecap="round" fill="none"><path d="M12 4v16M5 8.5l14 7M5 15.5l14-7"/></svg>`
  },
  {
    name: 'Mailchimp',
    bg: '#FFE01B',
    color: '#000',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2.5"><path d="M5 13l4-6 3 4 3-4 4 6"/><path d="M9 17c1.5 1.5 4.5 1.5 6 0" stroke-linecap="round"/></svg>`
  },
  {
    name: 'Shopify',
    bg: '#95BF47',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M17 7h-3V5c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H3v13c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V7zM10 5h4v2h-4V5zm-4 5h12v9H6v-9z"/></svg>`
