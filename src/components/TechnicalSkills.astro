---

<section class="tools-connect-section" aria-labelledby="tools-title">
  <div class="glow-wrapper" aria-hidden="true">
    <div class="glow-effect"></div>
  </div>

  <div class="container">
    <Heading level="h2" class="mb-8">Technical Skills &amp; Expertise</Heading>
    <p class="mb-12 max-w-3xl text-xl">
      Technologies and tools I use to build reliable, practical, and
      user-focused software solutions.</p>

    <div class="marquee-stack" aria-label="Technical skills and technologies">

      <div class="marquee-row">
        <ul class="marquee-group">
          {topRow.map((tool) => (
            <li class="tool-card">
              <div class="icon-circle" set:html={tool.icon} />
              <span class="tool-name" >
                {tool.name}
              </span>
            </li>
          ))}
        </ul>

        <ul class="marquee-group" aria-hidden="true">
          {topRow.map((tool) => (
            <li class="tool-card">
              <div class="icon-circle" set:html={tool.icon} />
              <span class="tool-name">
                {tool.name}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="marquee-row marquee-row--reverse">
        <ul class="marquee-group">
          {bottomRow.map((tool) => (
            <li class="tool-card">
              <div class="icon-circle" set:html={tool.icon} />
              <span class="tool-name">
                {tool.name}
              </span>
            </li>
          ))}
        </ul>

        <ul class="marquee-group" aria-hidden="true">
          {bottomRow.map((tool) => (
            <li class="tool-card">
              <div class="icon-circle" set:html={tool.icon}/>
              <span class="tool-name">
                {tool.name}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex justify-start mt-12">
      <Link
        href="/skills"
        isButton
        animateOnHover
        animationType="boop"
      >
        <Icon aria-hidden="true" name="lucide:code-2" size="1.5rem" />
        Explore My Skills
      </Link>
    </div>

  </div>
</section>
<style>
  .tools-connect-section {
    position: relative;
    padding: 2rem 0 2rem;
    overflow: hidden;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .glow-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    z-index: 0;
  }

  .glow-effect {
    width: 700px;
    height: 500px;
    background: radial-gradient(circle at center, rgba(30, 64, 175, 0.25) 0%, rgba(0, 0, 0, 0) 65%);
    filter: blur(60px);
    transform: translateY(-20%);
  }

  .container {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .header-content {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .header-content h2 {
    color: #ffffff;
    font-size: 2.75rem;
    font-weight: 400;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }

  .header-content p {
    color: #a1a1aa;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 2.5rem;
  }

  .marquee-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .marquee-row {
    padding: 5px;
    display: flex;
    gap: 1.25rem;
    overflow: hidden;
    width: 100%;
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }

  .marquee-group {
    display: flex;
    gap: 1.25rem;
    flex-shrink: 0;
    min-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: scroll-x 20s linear infinite;
  }

  .marquee-row--reverse .marquee-group {
    animation-direction: reverse;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 180px;
    height: 150px;
    background: #0a0a0a;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    gap: 1.25rem;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .tool-card:hover {
    background: #121212;
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .icon-circle {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tool-name {
    font-size: 0.95rem;
    font-weight: 500;
  }

  @keyframes scroll-x {
    from {
      transform: translateX(0);
    }
    to {
      /* Shifts the row left by exactly 100% of its width + 1 gap to perfectly loop */
      transform: translateX(calc(-100% - 1.25rem));
    }
  }

  @media (max-width: 768px) {
    .header-content h2 {
      font-size: 2rem;
    }

    .header-content p {
      font-size: 0.9rem;
    }

    .tool-card {
      width: 150px;
      height: 130px;
    }

    .icon-circle {
      width: 58px;
      height: 58px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-group {
      animation: none;
      transform: none;
    }
  }
</style>