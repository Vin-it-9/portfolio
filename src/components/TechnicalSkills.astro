---
// Define the tools with their brand colors and simplified inline SVGs
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { Heading } from 'accessible-astro-components'

const topRow = [
  {
    name: 'Intercom',
    bg: '#1F8DED',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M6 14v-2M10 16v-6M14 16v-6M18 14v-2"/></svg>`
  },
  {
    name: 'Kickstarter',
    bg: '#05CE78',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M8 4h3v16H8zM12.5 12.5l5.5 6.5h-3.5l-4.5-5.5 4.5-6.5h3.5z"/></svg>`
  },
  {
    name: 'Hubspot',
    bg: '#FF7A59',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="7" r="2.5" fill="white"/><circle cx="19" cy="16" r="2.5" fill="white"/><circle cx="5" cy="16" r="2.5" fill="white"/><path d="M11 9L7 14M13 9l4 5M6 16h12"/></svg>`
  },
  {
    name: 'Hubspot',
    bg: '#FF7A59',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="7" r="2.5" fill="white"/><circle cx="19" cy="16" r="2.5" fill="white"/><circle cx="5" cy="16" r="2.5" fill="white"/><path d="M11 9L7 14M13 9l4 5M6 16h12"/></svg>`
  },
  {
    name: 'Intercom',
    bg: '#1F8DED',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M6 14v-2M10 16v-6M14 16v-6M18 14v-2"/></svg>`
  }
