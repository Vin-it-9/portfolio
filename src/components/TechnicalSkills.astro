---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { Heading } from 'accessible-astro-components'

const topRow = [
  { name: 'Java', icon: '/icons/skills/java.svg' },
  { name: 'Spring', icon: '/icons/skills/spring.svg' },
  { name: 'Quarkus', icon: '/icons/skills/quarkus.svg' },
  { name: 'Micronaut', icon: '/icons/skills/micronaut.svg', adaptive: true },
  { name: 'Dropwizard', icon: '/icons/skills/dropwizard.svg' },
  { name: 'Hibernate', icon: '/icons/skills/hibernate.svg' },
  { name: 'Maven', icon: '/icons/skills/maven.svg' },
  { name: 'MySQL', icon: '/icons/skills/mysql.svg' },
]

const bottomRow = [
  { name: 'Kotlin', icon: '/icons/skills/kotlin.svg' },
  { name: 'GitHub', icon: '/icons/skills/github.svg' },
  { name: 'GraalVM', icon: '/icons/skills/graalvm.svg' },
  { name: 'Helidon', icon: '/icons/skills/helidon.svg' },
  { name: 'NextJs', icon: '/icons/skills/nextjs.svg' },
  { name: 'PostgreSQL', icon: '/icons/skills/postgresql.svg' },
  { name: 'Grails', icon: '/icons/skills/grails.svg' },
  { name: 'Javascript', icon: '/icons/skills/javascript.svg' },
]
---

<section class="tools-connect-section" aria-labelledby="tools-title">
  <div class="glow-wrapper" aria-hidden="true">
    <div class="glow-effect"></div>
  </div>

  <div class="container">
    <Heading level="h2" class="mb-8">Technical Skills &amp; Expertise</Heading>
    <p class="mb-12 max-w-3xl text-xl">
      Technologies and tools I use to build reliable, practical, and
      user-focused software solutions.
    </p>

    <div class="marquee-stack" aria-label="Technical skills and technologies">
      <div class="marquee-row">
        <ul class="marquee-group">
          {
            topRow.map((tool) => (
              <li class="tool-card">
                <div class="icon-circle">
                  <img
                    src={tool.icon}
                    alt={`${tool.name} logo`}
                    class={`tool-img ${tool.adaptive ? 'tool-img--adaptive' : ''}`}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="tool-name">{tool.name}</span>
              </li>
            ))
          }
        </ul>

        <ul class="marquee-group" aria-hidden="true">
          {
            topRow.map((tool) => (
              <li class="tool-card">
                <div class="icon-circle">
                  <img
                    src={tool.icon}
                    alt=""
                    class={`tool-img ${tool.adaptive ? 'tool-img--adaptive' : ''}`}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="tool-name">{tool.name}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="marquee-row marquee-row--reverse">
        <ul class="marquee-group">
          {
            bottomRow.map((tool) => (
              <li class="tool-card">
                <div class="icon-circle">
                  <img
                    src={tool.icon}
                    alt={`${tool.name} logo`}
                    class={`tool-img ${tool.adaptive ? 'tool-img--adaptive' : ''}`}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="tool-name">{tool.name}</span>
              </li>
            ))
          }
        </ul>

        <ul class="marquee-group" aria-hidden="true">
          {
            bottomRow.map((tool) => (
              <li class="tool-card">
                <div class="icon-circle">
                  <img
                    src={tool.icon}
                    alt=""
                    class={`tool-img ${tool.adaptive ? 'tool-img--adaptive' : ''}`}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="tool-name">{tool.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 flex justify-start">
      <Link href="/skills" isButton animateOnHover animationType="boop">
        <Icon aria-hidden="true" name="lucide:code-2" size="1.5rem" />
        Explore My Skills
      </Link>
    </div>
  </div>
</section>

<style>
  .tools-connect-section {
    position: relative;
    padding: 2rem 0 2rem;
    overflow: hidden;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .glow-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    z-index: 0;
  }

  .glow-effect {
    width: 700px;
    height: 500px;
    background: radial-gradient(
      circle at center,
      light-dark(rgba(214, 72, 255, 0.12), rgba(30, 64, 175, 0.22)) 0%,
      transparent 65%
    );
    filter: blur(60px);
    transform: translateY(-20%);
  }

  .container {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .marquee-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .marquee-row {
    padding: 5px;
    display: flex;
    gap: 1.25rem;
    overflow: hidden;
    width: 100%;
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }

  .marquee-group {
    display: flex;
    gap: 1.25rem;
    flex-shrink: 0;
    min-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: scroll-x 20s linear infinite;
  }

  .marquee-row--reverse .marquee-group {
    animation-direction: reverse;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 180px;
    height: 150px;
    background: light-dark(
      color-mix(in srgb, var(--background-color) 94%, var(--foreground-color) 6%),
      #0e0e11
    );
    border: 1px solid var(--border-color-subtle);
    border-radius: 16px;
    gap: 1.25rem;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .tool-card:hover {
    background: light-dark(var(--background-color), #16161b);
    transform: translateY(-4px);
    border-color: var(--link-color);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .icon-circle {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: light-dark(rgba(0, 0, 0, 0.03), rgba(255, 255, 255, 0.04));
    border: 1px solid var(--border-color-subtle);
  }

  .tool-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .tool-img--adaptive {
    filter: light-dark(invert(1) brightness(0.2), none);
  }

  .tool-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--foreground-color);
  }

  @keyframes scroll-x {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - 1.25rem));
    }
  }

  @media (max-width: 768px) {
    .tool-card {
      width: 150px;
      height: 130px;
    }

    .icon-circle {
      width: 58px;
      height: 58px;
    }

    .tool-img {
      width: 36px;
      height: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-group {
      animation: none;
      transform: none;
    }
  }
</style>
