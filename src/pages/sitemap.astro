---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Notification } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import { fetchBlogPosts, getBlogPostSlug } from '@lib/blog'

// Get all projects and blog posts
const projects = await getCollection('projects')
const posts = await fetchBlogPosts()

// Define static pages with their descriptions
const staticPages = [
  {
    title: 'Home',
    url: '/',
    description: 'The portfolio of Vinit Shinde, a Java and JVM developer building reliable backend systems and practical software.',
  },
  {
    title: 'Projects',
    url: '/projects',
    description: 'A collection of Java, Spring Boot, and full-stack projects I have built to explore ideas and apply what I learn.',
  },
  {
    title: 'Skills',
    url: '/skills',
    description: 'The languages, frameworks, databases, and tools I use to build software.',
  },
  {
    title: 'Resume',
    url: '/resume',
    description: 'A summary of my experience, education, and technical background.',
  },
  {
    title: 'Blog',
    url: '/blog',
    description: 'Articles and notes on Java, JVM, backend development, and software engineering.',
  },
  {
    title: 'Contact',
    url: '/contact',
    description: 'Contact me for development opportunities, projects, collaborations, and professional connections.',
  },
  {
    title: 'Accessibility statement',
    url: '/accessibility-statement',
    description: 'How this website approaches accessibility, including conformance, feedback, and technical details.',
  },
  {
    title: 'Sitemap',
    url: '/sitemap',
    description: 'A human-readable overview of the pages, projects, and articles available on this website.',
  },
]
---

<DefaultLayout
  title="Sitemap"
  description="Browse every page, project, and article on Vinit Shinde's portfolio website."
>
  <PageHeader
    title="Sitemap"
    subtitle="A complete overview of the pages, projects, and articles available on this website."
    bgType="gradient"
  />

  <section class="my-16">
    <div class="container space-y-12">
      <!-- Main Pages Section -->
      <div>
        <Heading level="h2" class="mb-6">Main pages</Heading>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            staticPages.map((page) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={page.url}>{page.title}</a>
                </Heading>
                <p class="mb-3">{page.description}</p>
                <p class="text-xs">
                  URL:{' '}
                  <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                    {page.url}
                  </code>
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Projects Section -->
      <div>
        <Heading level="h2">Projects</Heading>
        <p class="mb-6">
          Explore {projects.length} projects showcasing the ideas and technologies I have worked with.
        </p>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((project) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </Heading>
                <p class="mb-3">{project.data.description}</p>
                <p class="text-xs">
                  URL:{' '}
                  <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                    /projects/{project.id}
                  </code>
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Blog Section -->
      <div>
        <Heading level="h2" class="mb-6">Blog posts</Heading>
        {
          posts.length > 0 ? (
            <ul class="grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
              {posts.map((post) => (
                <li>
                  <article>
                    <Heading level="h3" size="h6" class="mb-3">
                      <a href={`/blog/${getBlogPostSlug(post)}`}>{post.title}</a>
                    </Heading>
                    {post.description && <p class="mb-3">{post.description}</p>}
                  </article>
                </li>
              ))}
            </ul>
          ) : (
            <p>New articles will appear here when the publishing platforms are reachable again.</p>
          )
        }
        <p class="mt-6">
          <a href="/blog">Browse the blog</a> or subscribe to the <a href="/rss.xml">RSS feed</a>.
        </p>
      </div>

      <!-- Technical Information -->
      <Notification type="info" variant="accent">
        <div class="space-content">
          <Heading level="h2" size="h6" class="mb-4">Technical sitemap information</Heading>
          <ul>
            <li>
              <span class="font-bold">XML sitemap:</span> An automated sitemap is generated at
              <code>/sitemap-index.xml</code>
              (also available at <code>/sitemap.xml</code>) for search engines.
            </li>
            <li>
              <span class="font-bold">RSS feed:</span> Blog posts are available at
              <code>/rss.xml</code>.
            </li>
            <li>
              <strong>Generated by:</strong> @astrojs/sitemap and Astro endpoints configured in
              <code>astro.config.mjs</code>
            </li>
            <li>
              <strong>Last updated:</strong> Automatically updated on each build
            </li>
          </ul>
        </div>
      </Notification>
    </div>
  </section>
</DefaultLayout>

<style>
  article {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-large);
    background-color: var(--background-color);
    padding: 1rem;
  }
</style>
