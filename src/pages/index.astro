---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import FeaturedPosts from '@components/FeaturedPosts.astro'
import { Accordion, AccordionItem, Avatar, AvatarGroup, Heading, Link } from 'accessible-astro-components'
import TechnicalSkills from '@components/TechnicalSkills.astro'
---

<DefaultLayout title="Vinit Shinde | Portfolio" useTitleTemplate={false}>
  <Hero />

  <section class="my-24">
    <div class="container">
      <Heading level="h2" class="mb-8">How I Approach Development</Heading>
      <p class="mb-12 max-w-3xl text-xl">
        I focus on understanding problems, writing clean code, and continuously improving through practical development.
      </p>

      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        <Feature icon="lucide:code-2" title="Clean & Maintainable">
          I focus on writing readable, structured code that is easy to understand, maintain, and improve.
        </Feature>

        <Feature icon="lucide:brain" title="Problem Solving">
          I break complex problems into smaller pieces and work toward practical and reliable solutions.
        </Feature>

        <Feature icon="lucide:book-open" title="Continuous Learning">
          I learn by exploring new concepts, experimenting with technologies, and turning what I learn into projects.
        </Feature>

        <Feature icon="lucide:wrench" title="Practical Development">
          I prefer learning through building real applications and applying concepts to solve practical problems.
        </Feature>

        <Feature icon="lucide:search-check" title="Attention to Detail">
          I care about correctness, code quality, usability, and the small details that make software better.
        </Feature>

        <Feature icon="lucide:lightbulb" title="Curiosity & Experimentation">
          I enjoy trying different approaches and technologies to understand how things work and find better solutions.
        </Feature>
      </div>
    </div>
  </section>

  <TechnicalSkills />
  <FeaturedProjects />
  <FeaturedPosts />

  <section class="my-24">
    <div class="container grid grid-cols-1 gap-12 md:grid-cols-2">
      <div class="flex flex-col items-start gap-4">
        <Heading level="h2">Beyond the Code</Heading>
        <p class="text-2xl">
          I believe good software comes from more than just writing code. I'm constantly learning, experimenting,
          solving problems, and turning ideas into practical solutions.
        </p>
      </div>

      <div class="space-content">
        <Accordion>
          <AccordionItem name="exclusive" title="Learn" open>
            <p>
              Strengthening my fundamentals and exploring new technologies through hands-on work. I focus on
              understanding how things work rather than simply using them.
            </p>
          </AccordionItem>

          <AccordionItem name="exclusive" title="Build">
            <p>
              Turning ideas and concepts into practical projects that solve real problems. Building projects helps me
              put what I learn into practice and discover better ways to approach challenges.
            </p>
          </AccordionItem>

          <AccordionItem name="exclusive" title="Improve">
            <p>
              Refining my code, understanding better approaches, and continuously raising my technical standards. Every
              project is an opportunity to learn something new and do the next one better.
            </p>
          </AccordionItem>
        </Accordion>
      </div>
    </div>
  </section>

</DefaultLayout>

<style>
  .avatar {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-s);
  }
</style>
