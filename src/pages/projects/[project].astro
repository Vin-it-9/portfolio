---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { absoluteUrl } from '@data/site'

export async function getStaticPaths() {
  const projects = await getCollection('projects')

  const projectImages = [
    { src: '/projects/project-image-1.png' },
    { src: '/projects/project-image-2.png' },
    { src: '/projects/project-image-3.png' },
    { src: '/projects/project-image-4.png' },
    { src: '/projects/project-image-5.png' },
    { src: '/projects/project-image-6.png' },
  ]

  return projects.map((project, index) => {
    const projectWithImage = {
      ...project,
      featuredImage: projectImages[index % projectImages.length].src,
    }

    return {
      params: { project: project.id },
      props: { project: projectWithImage },
    }
  })
}

interface Props {
  project: CollectionEntry<'projects'> & { featuredImage: string }
}

const { project } = Astro.props
const { Content } = await render(project)
const projectUrl = absoluteUrl(`/projects/${project.id}`)
const projectSchema = {
  '@type': 'CreativeWork',
  '@id': `${projectUrl}#project`,
  name: project.data.title,
  description: project.data.description,
  url: projectUrl,
  mainEntityOfPage: { '@id': `${projectUrl}#webpage` },
  image: absoluteUrl(project.featuredImage),
  keywords: project.data.tags.join(', '),
  creator: { '@id': `${absoluteUrl('/')}#person` },
  inLanguage: 'en',
}
---

<DefaultLayout
  title={project.data.title}
  description={project.data.description}
  url={`/projects/${project.id}`}
  image={project.featuredImage}
  imageAlt={`${project.data.title} — project preview`}
  structuredData={projectSchema}
>
  <PageHeader
    title={project.data.title}
    subtitle={project.data.description}
    bgType="bordered"
    featuredImage={project.featuredImage}
    featuredImageAlt={`${project.data.title} — project preview`}
    customBreadcrumbLabels={{ projects: 'Projects', [project.id]: project.data.title }}
  />
  <section class="my-12">
    <div class="narrow space-content container">
      <Content />
    </div>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  .narrow {
    margin-inline: auto;
    max-width: 65ch;
  }
</style>
