---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'

const driveFileId = '1dDfBj1K4by7a1ed7ZGQhk9HHSkGmZJKp'
const driveViewUrl = `https://drive.google.com/file/d/${driveFileId}/preview`
const driveDownloadUrl = `https://drive.google.com/uc?export=download&id=${driveFileId}`
---

<DefaultLayout title="Resume">
  <PageHeader title="Resume" subtitle="A quick look at my experience, skills, and background." bgType="gradient" />

  <section class="my-8">
    <div class="container">
      <div class="resume-actions">
        <a class="resume-download" href={driveDownloadUrl} download>
          Download Resume
        </a>
      </div>

      <div class="resume-viewer-wrap" aria-label="Embedded resume PDF viewer">
        <iframe
          class="resume-viewer"
          src={driveViewUrl}
          title="Resume PDF viewer"
          aria-label="Resume PDF viewer"
          loading="eager"
          allow="fullscreen"
          sandbox="allow-scripts allow-same-origin allow-popups"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .resume-actions {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }

  .resume-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1.2rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: linear-gradient(135deg, rgba(214, 72, 255, 0.12), rgba(0, 209, 183, 0.12));
    color: var(--foreground-color);
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
  }

  .resume-download:hover,
  .resume-download:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(214, 72, 255, 0.35);
    box-shadow: 0 14px 30px rgba(214, 72, 255, 0.14);
  }

  .resume-download:focus-visible {
    outline: 2px solid var(--outline-color);
    outline-offset: 3px;
  }

  .resume-viewer-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--border-color-subtle);
    background: rgba(255, 255, 255, 0.02);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.08);
  }

  .resume-viewer {
    display: block;
    width: 100%;
    min-height: 72vh;
    max-height: 90vh;
    height: 900px;
    border: 0;
    background: #ffffff;
  }

  @media (max-width: 768px) {
    .resume-actions {
      justify-content: center;
      margin-bottom: 1rem;
    }

    .resume-download {
      width: 100%;
    }

    .resume-viewer {
      min-height: 60vh;
      height: 70vh;
    }
  }
</style>
