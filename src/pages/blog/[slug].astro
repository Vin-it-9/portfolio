---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { fetchBlogPosts, getBlogPostSlug } from '@lib/blog'
import { absoluteUrl } from '@data/site'
import sanitizeHtml from 'sanitize-html'

export async function getStaticPaths() {
  const posts = await fetchBlogPosts()

  return posts.map((post) => ({
    params: { slug: getBlogPostSlug(post) },
    props: { post },
  }))
}

interface Props {
  post: Awaited<ReturnType<typeof fetchBlogPosts>>[number]
}

const { post } = Astro.props as Props
const postSlug = getBlogPostSlug(post)
const platformName = {
  devto: 'DEV.to',
  medium: 'Medium',
  hashnode: 'Hashnode',
  linkedin: 'LinkedIn',
} as const
const publishedDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(new Date(post.publishedAt))
const publishedIso = new Date(post.publishedAt).toISOString()
const postUrl = absoluteUrl(`/blog/${postSlug}`)
const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  headline: post.title,
  description: post.description ?? post.title,
  url: postUrl,
  mainEntityOfPage: { '@id': `${postUrl}#webpage` },
  isPartOf: { '@id': `${absoluteUrl('/blog')}#blog` },
  datePublished: publishedIso,
  dateModified: publishedIso,
  author: { '@id': `${absoluteUrl('/')}#person` },
  publisher: { '@id': `${absoluteUrl('/')}#person` },
  image: [post.image ? absoluteUrl(post.image) : absoluteUrl('/og-image.png')],
  articleSection: 'Blog',
  keywords: post.tags.join(', '),
  inLanguage: 'en',
  isBasedOn: post.url,
}
const safeContent = post.content
  ? sanitizeHtml(post.content, {
      allowedTags: [
        'a',
        'blockquote',
        'br',
        'caption',
        'code',
        'dd',
        'del',
        'div',
        'dl',
        'dt',
        'em',
        'figcaption',
        'figure',
        'h2',
        'h3',
        'h4',
        'hr',
        'img',
        'kbd',
        'li',
        'mark',
        'ol',
        'p',
        'pre',
        's',
        'small',
        'span',
        'strong',
        'sub',
        'sup',
        'table',
        'tbody',
        'td',
        'tfoot',
        'th',
        'thead',
        'time',
        'tr',
        'ul',
      ],
      allowedAttributes: {
        a: ['href', 'title', 'target', 'rel'],
        img: ['src', 'alt', 'width', 'height', 'loading', 'decoding'],
        td: ['colspan', 'rowspan'],
        th: ['colspan', 'rowspan', 'scope'],
        time: ['datetime'],
      },
    })
  : undefined
---

<DefaultLayout
  title={post.title}
  description={post.description ?? post.title}
  type="article"
  url={`/blog/${postSlug}`}
  image={post.image}
  imageAlt={`Cover image for ${post.title}`}
  publishedTime={publishedIso}
  modifiedTime={publishedIso}
  tags={post.tags}
  section="Blog"
  structuredData={blogPosting}
>
  <PageHeader
    title={post.title}
    subtitle={`${platformName[post.platform]} · <time datetime="${publishedIso}">${publishedDate}</time>`}
    bgType="bordered"
    customBreadcrumbLabels={{ blog: 'Blog', [postSlug]: post.title }}
  />
  <section class="my-12">
    <article class="narrow space-content container">
      {
        post.image && (
          <img
            src={post.image}
            alt={`Cover image for ${post.title}`}
            class="article-cover"
            loading="eager"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        )
      }
      {
        safeContent ? (
          <div class="blog-content" set:html={safeContent} />
        ) : post.description ? (
          <p class="text-xl">{post.description}</p>
        ) : (
          <p class="text-xl">Read the full article on {platformName[post.platform]}.</p>
        )
      }
      <div class="blog-actions">
        <a href="/blog">← Back to all posts</a>
        <a href={post.url} target="_blank" rel="noopener noreferrer">
          Read the original article on {platformName[post.platform]}
        </a>
      </div>
    </article>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  .narrow {
    margin-inline: auto;
    max-width: 65ch;
  }

  .blog-content {
    overflow-wrap: anywhere;
    font-size: var(--font-size-0);
    line-height: 1.75;

    > * {
      margin-block: 0;
    }

    > * + *,
    > div > * + * {
      margin-block-start: var(--space-s);
    }

    > h2 {
      margin-block-start: var(--space-xl);
      font-size: var(--font-size-3);
      line-height: 1.2;
      text-wrap: balance;
    }

    > h3 {
      margin-block-start: var(--space-l);
      font-size: var(--font-size-2);
      line-height: 1.3;
      text-wrap: balance;
    }

    > h4 {
      margin-block-start: var(--space-m);
      font-size: var(--font-size-1);
      line-height: 1.4;
    }

    > p {
      text-wrap: pretty;
    }

    > ul,
    > ol {
      display: grid;
      gap: var(--space-2xs);
      padding-inline-start: 1.5rem;
    }

    > li > p,
    > ul > li > p,
    > ol > li > p {
      margin: 0;
    }

    > blockquote {
      margin-inline: 0;
      padding: var(--space-s) var(--space-m);
      border-inline-start: 4px solid var(--link-color);
      border-radius: 0 var(--radius-m) var(--radius-m) 0;
      background: color-mix(in srgb, var(--link-color) 7%, var(--background-color));
      font-style: italic;
    }

    > blockquote > * + * {
      margin-block-start: var(--space-xs);
    }

    > pre {
      overflow-x: auto;
      padding: var(--space-s);
      border: 1px solid var(--border-color-subtle);
      border-radius: var(--radius-m);
      background: color-mix(in srgb, var(--foreground-color) 6%, var(--background-color));
      font-size: var(--font-size--1);
      line-height: 1.6;
    }

    > code {
      padding: 0.15em 0.35em;
      border-radius: 0.25rem;
      background: color-mix(in srgb, var(--foreground-color) 8%, var(--background-color));
      font-size: 0.9em;
    }

    > pre code {
      padding: 0;
      background: none;
      font-size: inherit;
    }

    > img {
      display: block;
      max-width: 100%;
      height: auto;
      margin-inline: auto;
      border-radius: var(--radius-m);
    }

    > figure {
      margin-inline: 0;
    }

    > figcaption {
      margin-block-start: var(--space-2xs);
      color: color-mix(in srgb, var(--foreground-color) 70%, transparent);
      font-size: var(--font-size--1);
      text-align: center;
    }

    > hr {
      margin-block: var(--space-l);
      border: 0;
      border-block-start: 1px solid var(--border-color-subtle);
    }

    > table {
      display: block;
      overflow-x: auto;
      width: 100%;
      border-collapse: collapse;
      font-size: var(--font-size--1);
    }

    th,
    td {
      padding: var(--space-2xs) var(--space-xs);
      border: 1px solid var(--border-color-subtle);
      text-align: start;
      vertical-align: top;
    }

    th {
      background: color-mix(in srgb, var(--foreground-color) 6%, var(--background-color));
      font-weight: 700;
    }

    > dl {
      display: grid;
      gap: var(--space-2xs);
    }

    dt {
      font-weight: 700;
    }

    dd {
      margin-inline-start: 1.5rem;
    }

    mark {
      padding-inline: 0.15em;
      background: color-mix(in srgb, var(--color-secondary-500) 28%, transparent);
    }
  }

  .article-cover {
    display: block;
    width: 100%;
    max-height: 30rem;
    object-fit: cover;
    border-radius: var(--radius-m);
  }

  .blog-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border-color-subtle);
  }
</style>
