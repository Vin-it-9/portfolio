---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import {
  Input,
  Button,
  Textarea,
  Heading,
  Link,
  Notification,
} from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="Contact">
  <PageHeader
    title="Contact"
    subtitle="Have a question? Get in touch with me!"
    bgType="gradient"
  />

  <section class="my-8">
    <div class="container">
      <Heading level="h2">Let's talk</Heading>
    </div>
  </section>

  <section class="container">
    <div class="grid grid-cols-1 gap-32 md:grid-cols-2">
      <!-- Contact Form -->
      <div class="space-content">
        <form
          name="contact"
          class="form js-validate"
          action="/"
          method="post"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
        >
          <Notification type="error" ariaLive="polite" variant="accent" hidden />

          <input type="hidden" name="form-name" value="contact" />
          <p hidden>
            <label>
              Don't fill this out if you're human:
              <input name="bot-field" />
            </label>
          </p>

          <Input
            name="name"
            label="Your name"
            required
            data-validation="Please enter your name"
            autocomplete="name"
          />

          <Input
            name="email"
            label="Email address"
            type="email"
            required
            autocomplete="email"
          />

          <Textarea
            name="message"
            label="Message"
            required
          />

          <Button htmlType="submit" type="primary">
            Send Message
          </Button>
        </form>
      </div>

      <!-- Contact Information -->
      <div class="space-content">
        <Heading level="h3">Get in touch</Heading>

        <p class="text-lg">
          I'm a Java Developer interested in building reliable, maintainable
          and practical software applications. I'm always open to discussing
          development opportunities, projects, ideas, and professional
          connections.
        </p>

        <p>
          You can contact me directly through email or connect with me on
          LinkedIn and GitHub to learn more about my work and projects.
        </p>

        <!-- Email -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:mail"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">Email:</span>
            <Link href="mailto:vineetshinde2559@gmail.com">
              vineetshinde2559@gmail.com
            </Link>
          </p>
        </div>

        <!-- Phone -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:phone"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">Phone:</span>
            <Link href="tel:+919623912441">
              +91 9623912441
            </Link>
          </p>
        </div>

        <!-- LinkedIn -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:linkedin"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">LinkedIn:</span>
            <Link
              href="https://www.linkedin.com/in/vinit-shinde-920531254/"
              isExternal
            >
              Connect with me on LinkedIn
            </Link>
          </p>
        </div>

        <!-- GitHub -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:github"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">GitHub:</span>
            <Link
              href="https://github.com/Vin-it-9/"
              isExternal
            >
              View my GitHub
            </Link>
          </p>
        </div>

        <!-- Resume -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:file-text"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">Resume:</span>
            <Link href="/resume">
              View my resume
            </Link>
          </p>
        </div>

      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.querySelector('form[name="contact"]')

      if (!form || form.dataset.contactInitialized === 'true') {
        return
      }

      form.dataset.contactInitialized = 'true'

      let isSubmitting = false

      const requiredFields = form.querySelectorAll('[required]')
      const submitButton = form.querySelector('button[type="submit"]')
      const errorNotification = form.querySelector('.notification')
      const errorNotificationContent = errorNotification?.querySelector('p')
      const defaultErrorSummary =
        'There was a problem with your submission. The following inputs need attention:'

      const escapeHTML = (value) =>
        String(value ?? '').replace(/[&<>"']/g, (character) => {
          switch (character) {
            case '&':
              return '&amp;'
            case '<':
              return '&lt;'
            case '>':
              return '&gt;'
            case '"':
              return '&quot;'
            case "'":
              return '&#39;'
            default:
              return character
          }
        })

      const validateField = (field) => {
        if (!field.willValidate) return true

        const value = field.value.trim()
        const type = field.type

        if (field.required && type === 'checkbox') {
          return field.checked
        }

        if (field.required && type === 'radio') {
          return field.checked
        }

        if (field.required && !value) {
          return false
        }

        if (type === 'email' && value) {
          return /\S+@\S+\.\S+/.test(value)
        }

        return true
      }

      const setSummary = (fields) => {
        if (!errorNotification || !errorNotificationContent) return

        errorNotification.setAttribute('tabindex', '-1')
        errorNotificationContent.innerHTML = `
          <div class="space-content">
            <p>${escapeHTML(defaultErrorSummary)}</p>
            <ol class="incremented">
              ${fields
                .map((field) => {
                  const elementId = escapeHTML(field.id)
                  const label = field
                    .closest('.input-group, .checkbox-group, .textarea-group')
                    ?.querySelector('label')
                  const labelText = escapeHTML(label?.textContent || field.name)
                  const validation = escapeHTML(
                    label?.dataset.validation || 'This field is required'
                  )

                  return `<li><a href="#${elementId}">${labelText}: ${validation}</a></li>`
                })
                .join('')}
            </ol>
          </div>
        `

        errorNotification.hidden = false
        errorNotification.focus()
        errorNotification.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      }

      const setInlineMessages = (fields) => {
        fields.forEach((field) => {
          const label = field
            .closest('.input-group, .checkbox-group, .textarea-group')
            ?.querySelector('label')
          const validation = label?.dataset.validation || 'This field is required'
          const messageElement = field.nextElementSibling?.querySelector('.message')

          if (messageElement) {
            messageElement.textContent = validation
          }
        })
      }

      const clearValidation = () => {
        requiredFields.forEach((field) => {
          field.setAttribute('aria-invalid', 'false')
        })

        if (errorNotification) {
          errorNotification.hidden = true
          errorNotification.setAttribute('role', 'none')
        }

        if (errorNotificationContent) {
          errorNotificationContent.innerHTML = ''
        }

        form.querySelectorAll('.message').forEach((message) => {
          message.textContent = ''
        })
      }

      const setErrorMessage = (message) => {
        if (!errorNotification || !errorNotificationContent) return

        errorNotification.hidden = false
        errorNotification.setAttribute('role', 'alert')
        errorNotificationContent.innerHTML = `<strong>Message:</strong> ${escapeHTML(message)}`
        errorNotification.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault()

        // Guard against double submissions (double-click, double Enter, etc.)
        if (isSubmitting) {
          return
        }

        clearValidation()

        const invalidFields = []

        requiredFields.forEach((field) => {
          if (!validateField(field)) {
            field.setAttribute('aria-invalid', 'true')
            invalidFields.push(field)
          }
        })

        if (invalidFields.length > 0) {
          setSummary(invalidFields)
          setInlineMessages(invalidFields)
          return
        }

        const formData = new URLSearchParams(new FormData(form)).toString()

        isSubmitting = true
        if (submitButton) {
          submitButton.disabled = true
        }

        try {
          const response = await fetch('/', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: formData,
          })

          if (!response.ok) {
            throw new Error('Your message could not be sent. Please try again.')
          }

          // Use replace() so the POST page is not kept in history,
          // preventing any back/forward-triggered resubmission or
          // reload loop once the browser lands on /thank-you.
          window.location.replace('/thank-you/')
        } catch (error) {
          const message =
            error instanceof Error ? error.message : 'Your message could not be sent. Please try again.'

          setErrorMessage(message)
          isSubmitting = false
          if (submitButton) {
            submitButton.disabled = false
          }
        }
      })
    })()
  </script>
</DefaultLayout>