---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import {
  Form,
  Input,
  Button,
  Textarea,
  Heading,
  Link,
} from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="Contact">
  <PageHeader
    title="Contact"
    subtitle="Have a question? Get in touch with me!"
    bgType="gradient"
  />

  <section class="my-8">
    <div class="container">
      <Heading level="h2">Let's talk</Heading>
    </div>
  </section>

  <section class="container">
    <div class="grid grid-cols-1 gap-32 md:grid-cols-2">
      <!-- Contact Form -->
      <div class="space-content">
        <Form
          name="contact"
          action="/thank-you/"
          method="post"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p hidden>
            <label>
              Don't fill this out if you're human:
              <input name="bot-field" />
            </label>
          </p>

          <Input
            name="name"
            label="Your name"
            required
            data-validation="Please enter your name"
            autocomplete="name"
          />

          <Input
            name="email"
            label="Email address"
            type="email"
            required
            autocomplete="email"
          />

          <Textarea
            name="message"
            label="Message"
            required
          />

          <Button htmlType="submit" type="primary">
            Send Message
          </Button>
        </Form>
      </div>

      <!-- Contact Information -->
      <div class="space-content">
        <Heading level="h3">Get in touch</Heading>

        <p class="text-lg">
          I'm a Java Developer interested in building reliable, maintainable
          and practical software applications. I'm always open to discussing
          development opportunities, projects, ideas, and professional
          connections.
        </p>

        <p>
          You can contact me directly through email or connect with me on
          LinkedIn and GitHub to learn more about my work and projects.
        </p>

        <!-- Email -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:mail"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">Email:</span>
            <Link href="mailto:vineetshinde2559@gmail.com">
              vineetshinde2559@gmail.com
            </Link>
          </p>
        </div>

        <!-- Phone -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:phone"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">Phone:</span>
            <Link href="tel:+919623912441">
              +91 9623912441
            </Link>
          </p>
        </div>

        <!-- LinkedIn -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:linkedin"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">LinkedIn:</span>
            <Link
              href="https://www.linkedin.com/in/vinit-shinde-920531254/"
              isExternal
            >
              Connect with me on LinkedIn
            </Link>
          </p>
        </div>

        <!-- GitHub -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:github"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">GitHub:</span>
            <Link
              href="https://github.com/Vin-it-9/"
              isExternal
            >
              View my GitHub
            </Link>
          </p>
        </div>

        <!-- Resume -->
        <div class="gap-2xs flex items-center">
          <Icon
            aria-hidden="true"
            name="lucide:file-text"
            size={20}
            class="flex-shrink-0"
          />

          <p>
            <span class="font-bold">Resume:</span>
            <Link href="/resume">
              View my resume
            </Link>
          </p>
        </div>

      </div>
    </div>
  </section>
</DefaultLayout>
