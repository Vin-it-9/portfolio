---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'

const categories = [
  {
    title: 'Core Development',
    skills: ['Java', 'Object-Oriented Programming', 'Collections', 'Exception Handling', 'Multithreading', 'JVM'],
  },
  {
    title: 'Backend & APIs',
    skills: ['REST APIs', 'Spring Boot', 'Spring Framework', 'API Design', 'Backend Development'],
  },
  {
    title: 'Databases',
    skills: ['SQL', 'MySQL', 'JDBC', 'JPA / Hibernate'],
  },
  {
    title: 'Development Tools',
    skills: ['Git', 'GitHub', 'Maven', 'IntelliJ IDEA', 'Postman'],
  },
  {
    title: 'Problem Solving',
    skills: ['Data Structures & Algorithms', 'Problem Solving', 'Debugging', 'Clean Code'],
  },
]
---

<DefaultLayout title="Skills">
  <PageHeader
    title="Skills"
    subtitle="Technologies and tools I use to build software and solve problems."
    bgType="gradient"
  />

  <section class="skills-section" aria-labelledby="skills-heading">
    <div class="container">
      <div class="skills-grid">
        {categories.map((category) => (
          <article class="skill-card" aria-labelledby={`${category.title.toLowerCase().replace(/\s+/g, '-')}-heading`}>
            <div class="card-header">
              <span class="card-badge">Skill set</span>
              <h2 id={`${category.title.toLowerCase().replace(/\s+/g, '-')}-heading`}>{category.title}</h2>
            </div>

            <ul class="skill-list" aria-label={`${category.title} skills`}>
              {category.skills.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .skills-section {
    padding: 3rem 0 4rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .skill-card {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--border-color-subtle);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--background-color) 92%, transparent);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.04);
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-badge {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border-color-subtle);
    border-radius: 999px;
    background: color-mix(in srgb, var(--background-color) 88%, transparent);
    color: var(--foreground-color);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-header h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.3;
    color: var(--foreground-color);
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
  }

  .skill-list li {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--border-color-subtle);
    border-radius: 999px;
    background: color-mix(in srgb, var(--background-color) 82%, transparent);
    color: var(--foreground-color);
    font-size: 0.96rem;
    line-height: 1.4;
    word-break: break-word;
  }

  @media (min-width: 700px) {
    .skill-card {
      grid-column: span 6;
    }
  }

  @media (min-width: 1024px) {
    .skill-card {
      grid-column: span 4;
    }
  }
</style>
